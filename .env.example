# The Press24 production authentication
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://thepress24.vercel.app
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret

# Supabase PostgreSQL
# Prefer the Supabase Transaction Pooler connection string for Vercel.
DATABASE_URL=postgresql://...?...sslmode=require
